# Rust build output
/target/

# Personal, never published: migration notes, reports, local config
*.local
*.local.*
/private/
/reports/
/backups/
.env

# Mailbox data must never be committed
*.pst
*.ost
*.msg
*.eml
*.ics
*.vcf
# Synthetic test fixtures, no mailbox data (see their README)
!/crates/*/tests/fixtures/*.pst

# Local state databases
*.sqlite
*.sqlite3
*.db

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Release packages, built by scripts/build.ps1 release.
dist/
